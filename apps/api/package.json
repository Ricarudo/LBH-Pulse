{
  "name": "@pulse/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run prisma:generate && tsx watch src/main.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "npm run prisma:generate && tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "npm run typecheck && node --test --import tsx src/shared/*.spec.ts src/lib/importers/*.spec.ts src/lib/services/*.spec.ts src/lib/validations/*.spec.ts src/items/*.spec.ts src/item-relations/*.spec.ts src/modules/quote-items/*.spec.ts src/modules/quotes/*.spec.ts",
    "prisma:generate": "prisma generate",
    "db:init:dev": "tsx prisma/assert-uninitialized.ts && npm run prisma:generate && prisma migrate deploy && npm run db:seed:apply",
    "db:init:test": "tsx prisma/assert-uninitialized.ts && npm run prisma:generate && prisma migrate deploy && npm run db:seed:apply",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:baseline:preview": "tsx scripts/database/adopt-baseline.ts",
    "db:baseline:apply": "tsx scripts/database/adopt-baseline.ts --apply",
    "db:baseline:verify-ci": "tsx scripts/database/verify-baseline-adoption-ci.ts",
    "db:roles:preview": "tsx scripts/database/provision-roles.ts",
    "db:roles:apply": "tsx scripts/database/provision-roles.ts --apply",
    "db:roles:verify": "tsx scripts/database/verify-runtime-role.ts",
    "db:reference-data:preview": "npm run prisma:generate && tsx prisma/bootstrap.ts",
    "db:reference-data:apply": "npm run prisma:generate && tsx prisma/bootstrap.ts --apply",
    "db:reference-data:apply:prebuilt": "tsx prisma/bootstrap.ts --apply",
    "db:import:ubiquiti:preview": "npm run prisma:generate && tsx prisma/import-ubiquiti-items.ts",
    "db:import:ubiquiti:apply": "npm run prisma:generate && tsx prisma/import-ubiquiti-items.ts --apply",
    "db:lifecycle-contexts:preview": "npm run prisma:generate && tsx prisma/backfill-lifecycle-contexts.ts",
    "db:lifecycle-contexts:apply": "npm run prisma:generate && tsx prisma/backfill-lifecycle-contexts.ts --apply",
    "db:lifecycle-contexts:placeholder-sites": "npm run prisma:generate && tsx prisma/backfill-lifecycle-contexts.ts --apply --create-placeholder-sites",
    "db:item-price-history:preview": "npm run prisma:generate && tsx prisma/backfill-item-price-history.ts",
    "db:item-price-history:apply": "npm run prisma:generate && tsx prisma/backfill-item-price-history.ts --apply",
    "db:lifecycle-events:preview": "npm run prisma:generate && tsx prisma/backfill-lifecycle-events.ts",
    "db:lifecycle-events:apply": "npm run prisma:generate && tsx prisma/backfill-lifecycle-events.ts --apply",
    "legacy:audit:quote-revisions": "npm run prisma:generate && tsx prisma/backfill-quote-revisions.ts",
    "legacy:audit:quote-contacts": "npm run prisma:generate && tsx prisma/backfill-quote-contacts.ts",
    "legacy:audit:quote-financials": "npm run prisma:generate && tsx prisma/backfill-quote-financials.ts",
    "db:seed:preview": "tsx prisma/seed.ts",
    "db:seed:apply": "tsx prisma/seed.ts --apply",
    "db:reset:demo": "tsx prisma/assert-demo-reset.ts && npm run prisma:generate && prisma migrate reset --force --skip-seed && npm run db:seed:apply",
    "auth:bootstrap:preview": "tsx scripts/auth/bootstrap-admin.ts",
    "auth:bootstrap:apply": "tsx scripts/auth/bootstrap-admin.ts --apply",
    "auth:bootstrap:rotate": "tsx scripts/auth/bootstrap-admin.ts --apply --rotate-existing",
    "auth:first-run:verify-ci": "tsx scripts/auth/verify-first-run-ci.ts",
    "auth:containment:preview": "tsx scripts/auth/credential-containment.ts",
    "auth:containment:apply": "tsx scripts/auth/credential-containment.ts --apply",
    "data:audit": "tsx scripts/data/quality-audit.ts",
    "data:known-anomalies:preview": "tsx scripts/data/repair-known-anomalies.ts",
    "data:known-anomalies:apply": "tsx scripts/data/repair-known-anomalies.ts --apply",
    "lifecycle:audit": "tsx scripts/lifecycle/audit-repair.ts",
    "lifecycle:duplicates:apply": "tsx scripts/lifecycle/audit-repair.ts --apply --mark-exact-duplicates",
    "compatibility:checklists:preview": "tsx scripts/compatibility/adopt-legacy-checklists.ts",
    "compatibility:checklists:apply": "tsx scripts/compatibility/adopt-legacy-checklists.ts --apply",
    "verify:data-integrity": "tsx scripts/verification/data-integrity.ts",
    "verify:data-integrity:deep": "tsx scripts/verification/data-integrity.ts --deep-documents",
    "verify:data-fingerprint": "tsx scripts/verification/release-data-fingerprint.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1072.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@pulse/contracts": "*",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "25.6.2",
    "dotenv": "^16.6.1",
    "prisma": "7.9.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.20.0",
    "typescript": "6.0.3"
  }
}
