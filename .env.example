# Pulse 0.1 environment template. Copy this file to an ignored environment file
# and replace every angle-bracket placeholder. Never commit the populated file.

# Release and public endpoint
NODE_ENV=production
PULSE_RELEASE_TAG=<immutable-release-tag>
PULSE_PUBLIC_URL=https://<pulse-hostname>
PULSE_HOSTNAME=<pulse-hostname>
PULSE_CADDY_TARGET=<internal-or-public>
PULSE_CADDY_EMAIL=<acme-contact-email>
PULSE_HTTP_PORT=80
PULSE_HTTPS_PORT=443

# PostgreSQL bootstrap, migration, and runtime identities
POSTGRES_IMAGE=postgres:16.14-alpine
POSTGRES_DB=pulse
POSTGRES_ADMIN_USER=<postgres-admin-user>
POSTGRES_ADMIN_PASSWORD=<generate-a-unique-password>
PULSE_DB_MIGRATION_USER=<pulse-migration-user>
PULSE_DB_MIGRATION_PASSWORD=<generate-a-different-password>
PULSE_DB_APP_USER=<pulse-runtime-user>
PULSE_DB_APP_PASSWORD=<generate-a-different-password>
PULSE_DATABASE_ADMIN_URL=postgresql://<admin-user>:<admin-password>@postgres:5432/pulse?schema=pulse
PULSE_DATABASE_MIGRATION_URL=postgresql://<migration-user>:<migration-password>@postgres:5432/pulse?schema=pulse
DATABASE_URL=postgresql://<runtime-user>:<runtime-password>@postgres:5432/pulse?schema=pulse
PULSE_LEGACY_DATABASE_ROLE=<existing-role-or-empty>
PULSE_POSTGRES_VOLUME=pulse-postgres-data

# MinIO administrative and bucket-scoped application identities
MINIO_ROOT_USER=<minio-root-user>
MINIO_ROOT_PASSWORD=<generate-a-unique-password>
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=pulse-documents
S3_ACCESS_KEY=<pulse-minio-application-user>
S3_SECRET_KEY=<generate-a-different-password>
S3_FORCE_PATH_STYLE=true
PULSE_MINIO_VOLUME=pulse-minio-data

# Authentication and session security
PULSE_SESSION_SECRET=<at-least-64-random-characters>
PULSE_SECURITY_PEPPER=<at-least-64-different-random-characters>
# One-time code for the first browser-based Administrator setup. Generate at
# least 64 random characters, then remove the value and redeploy after setup.
PULSE_SETUP_TOKEN=<at-least-64-random-characters-used-once>
PULSE_SESSION_TTL_MINUTES=480
PULSE_SESSION_IDLE_MINUTES=30
PULSE_COOKIE_SECURE=true
PULSE_COOKIE_SAME_SITE=strict
PULSE_TRUST_PROXY_HOPS=2
PULSE_ALLOWED_ORIGINS=https://<pulse-hostname>
PULSE_AUTH_RATE_LIMIT_ENABLED=true
PULSE_LOGIN_WINDOW_SECONDS=900
PULSE_LOGIN_ACCOUNT_MAX_ATTEMPTS=5
PULSE_LOGIN_IP_MAX_ATTEMPTS=25
PULSE_LOGIN_LOCKOUT_SECONDS=900
PULSE_REQUIRE_CREDENTIAL_CONTAINMENT=true

# One-time bootstrap and maintenance commands
PULSE_BOOTSTRAP_ADMIN_NAME=<administrator-name>
PULSE_BOOTSTRAP_ADMIN_EMAIL=<administrator-email>
PULSE_BOOTSTRAP_ADMIN_PASSWORD_FILE=</absolute/path/to/root-owned-password-file>
PULSE_ADMIN_ROTATION_ID=<unique-change-ticket-for-each-explicit-rotation>
PULSE_MAINTENANCE_ACTOR_EMAIL=<administrator-email>
PULSE_CREDENTIAL_CONTAINMENT_FILE=</absolute/path/to-root-owned-containment-json>
# Ephemeral reviewed digest for an approved repair only; leave empty normally.
PULSE_REPAIR_REPORT_DIGEST=
PULSE_ENABLE_DEMO_SEED=false
# Development/test only. Leave unset in production:
PULSE_DEMO_ADMIN_PASSWORD=<development-only-random-password>
PULSE_DEMO_SALES_PASSWORD=<development-only-random-password>
PULSE_DEMO_PROJECT_MANAGER_PASSWORD=<development-only-random-password>
PULSE_DEMO_TECHNICIAN_PASSWORD=<development-only-random-password>

# Supporting services
CLAMAV_HOST=clamav
CLAMAV_BASE_IMAGE=clamav/clamav:stable
CLAMAV_PLATFORM=linux/amd64
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=180000
DOCUMENT_TEMP_DIR=/tmp/pulse-uploads
PULSE_AUDIT_RETENTION_DAYS=365
PULSE_OPERATIONAL_RETENTION_DAYS=730

# Encrypted backup and restore
BACKUP_CRYPTO_BASE_IMAGE=alpine:3.22.1
PULSE_BACKUP_DIR=</absolute/off-repository/backup/path>
PULSE_BACKUP_AGE_RECIPIENT=<age-public-recipient>
PULSE_BACKUP_AGE_IDENTITY_FILE=</absolute/path/to-age-identity-for-restore>
PULSE_BACKUP_RETENTION_DAYS=30
PULSE_BACKUP_PRUNE=0
PULSE_RESTORE_POSTGRES_VOLUME=<new-restore-volume-name>
PULSE_RESTORE_MINIO_VOLUME=<new-restore-volume-name>
